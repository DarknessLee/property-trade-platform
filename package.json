{
  "name": "property-trade-platform",
  "version": "1.0.0",
  "private": true,
  "description": "房产交易数字化协同平台 Demo",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run start:dev -w server",
    "dev:web": "npm run dev -w web",
    "db:reset": "npm run db:reset -w server",
    "db:seed": "npm run db:seed -w server",
    "db:validate": "npm run db:validate -w server",
    "build": "npm run build -w server && npm run build -w web",
    "test:api": "npm run test:api -w server",
    "test:e2e": "playwright test --project=chromium",
    "screenshots": "playwright test --project=screenshots",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run db:reset && npm run build && npm run test:api && npm run test:e2e && npm run check:docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3"
  }
}
